  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "expo": "~52.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "~0.19.13",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo-web-browser": "~14.0.2",
    "expo-location": "~18.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
