{
  "name": "pet-stayz",
  "version": "1.0.0",
  "private": true,
  "description": "Pet Stayz \u2014 Australian pet accommodation aggregator for boarding, sitting, and daycare hosts",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/inject-ga.js && cp web/auth-popup.html dist/auth-popup.html"
  },
  "keywords": [
    "react-native",
    "expo",
    "pets",
    "boarding",
    "daycare",
    "alphinium"
  ],
