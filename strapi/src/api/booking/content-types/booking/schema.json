{
  "kind": "collectionType",
  "collectionName": "bookings",
  "info": {
    "singularName": "booking",
    "pluralName": "bookings",
    "displayName": "Booking",
    "description": "Guest booking requests against a host listing. Drives the accept/decline flow (issue #6). Status transitions: pending → accepted | declined."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginsOptions": {
    "users-permissions": {
      "enabled": true
    }
  },
  "attributes": {
    "check_in": {
      "type": "date",
      "required": true
    },
    "check_out": {
      "type": "date",
      "required": true
    },
    "pet_ids": {
      "type": "json"
    },
    "message": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "accepted", "declined"],
      "default": "pending",
      "required": true
    },
    "total_price": {
      "type": "decimal",
      "required": false
    },
    "host": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::host.host"
    },
    "guest": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": ["unpaid", "pending", "paid", "refunded"],
      "default": "unpaid"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_checkout_url": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    }
  }
}
